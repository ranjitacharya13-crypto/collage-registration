# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit real credentials to this file.

API_PORT=1215
# Kept local by default. Only use 0.0.0.0 when intentionally allowing LAN access.
API_HOST=127.0.0.1

# Optional for local use; required if API_HOST is exposed to a network.
MCP_TOKEN=set-a-long-random-secret-before-network-use

# Administrator access for the hidden dashboard. Change these before deployment.
ADMIN_PIN=0000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Supabase (only if you enable the hosted backend in src/supabase.js).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: only needed by the MCP 'chat' tool (local Ollama).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
