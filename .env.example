# Copy to .env and fill in real values:  cp .env.example .env
# Put REAL secrets only in .env (gitignored). Never in this file - it is committed.

API_PORT=1215
# Kept local by default. Only use 0.0.0.0 when intentionally allowing LAN access.
API_HOST=127.0.0.1

# Administrator access for the hidden dashboard. Change before deployment.
# Generate strong values with:
#   node -e "console.log(require('crypto').randomInt(1000,10000), require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PIN=0000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ---------------------------------------------------------------------------
# PERMANENT DATABASE (Supabase)
# Set both values to store registrations in the cloud instead of a local file.
# Leave them blank to use the local SQLite file at data/aura.db.
#
# Find them in the Supabase dashboard:
#   Project Settings -> API
#     SUPABASE_URL              = "Project URL"
#     SUPABASE_SERVICE_ROLE_KEY = "service_role" / "secret" key (click Reveal)
#
# Run supabase-schema.sql once in the SQL Editor before first use.
# The service role key bypasses Row Level Security: keep it server-side only,
# never in src/ and never committed.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required on serverless hosts (Vercel, Netlify, Lambda) so signed admin
# session cookies are accepted by every instance. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional hard cap on total registrations. 0 or unset = unlimited.
TOTAL_CAPACITY=0

# Optional: only needed by the MCP 'chat' tool (local Ollama).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
