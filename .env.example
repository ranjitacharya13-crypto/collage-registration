# Copy to .env and fill in real values:  cp .env.example .env
# Put REAL secrets only in .env (gitignored). Never in this file - it is committed.

API_PORT=1215
# Kept local by default. Only use 0.0.0.0 when intentionally allowing LAN access.
API_HOST=127.0.0.1

# Administrator access for the hidden dashboard. Change before deployment.
# Generate strong values with:
#   node -e "console.log(require('crypto').randomInt(1000,10000), require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_PIN=0000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional hard cap on total registrations. 0 or unset = unlimited.
TOTAL_CAPACITY=0

# Optional: where the SQLite database lives.
# DATA_DIR=./data

# Optional: only needed by the MCP 'chat' tool (local Ollama).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
